# =============================================================================
# libereal Production Environment Variables
# Copy this file to .env and fill in real values.
# DO NOT commit .env to git (already in .gitignore)
# =============================================================================

# Database (SQLite)
# Dev default: prisma/dev.db (via DATABASE_PATH fallback in src/lib/databasePath.ts)
# Production: mount a persistent volume and set an absolute path
DATABASE_URL="file:./prisma/dev.db"
DATABASE_PATH="/data/production.db"

# NextAuth v5 (https://next-auth.js.org)
# Generate with: openssl rand -hex 32
AUTH_SECRET=""
AUTH_URL=

# Identity security rollout switches. Keep disabled until staging acceptance is complete.
MFA_PHASE1_ENABLED="false"
MFA_ADMIN_REQUIRED="false"
PASSKEY_ENABLED="false"

# Internal research-knowledge staging page. Both values are required; keep disabled in production.
KNOWLEDGE_STAGING_ENABLED="false"
KNOWLEDGE_DEPLOYMENT_ENV="production"

# WebAuthn / Passkey. Set the RP ID and origin for each deployment environment.
# Staging example: staging.libereal.cn / https://staging.libereal.cn
WEBAUTHN_RP_ID=""
WEBAUTHN_ORIGINS=""
WEBAUTHN_RP_NAME="LIBEREAL"

# Google OAuth (https://console.cloud.google.com/)
# Required for Google sign-in. Without both vars, the Google button will fail with "Configuration".
# Authorized redirect URI must be: ${AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Mainland China VPS: proxy only Google OAuth token/userinfo requests.
# GOOGLE_OAUTH_PROXY_URL=

# WeChat OAuth (https://open.weixin.qq.com/)
# WebsiteApp (网站应用): desktop QR login — AUTH_WECHAT_ID / AUTH_WECHAT_SECRET
AUTH_WECHAT_ID=""
AUTH_WECHAT_SECRET=""
NEXT_PUBLIC_AUTH_WECHAT_ID=""
# OfficialAccount (公众号): mobile / WeChat in-app OAuth — separate AppID
AUTH_WECHAT_MP_ID=""
AUTH_WECHAT_MP_SECRET=""
NEXT_PUBLIC_AUTH_WECHAT_MP_ID=""
# Mini Program (小程序): Safari mobile login relay via wx.login + code2Session
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=""
NEXT_PUBLIC_WECHAT_MINI_APP_ID=
# Mini Program review-only test login. This does not create a real website session.
# Keep disabled by default; configure only on an isolated staging environment.
WECHAT_MINI_REVIEW_USERNAME=""
WECHAT_MINI_REVIEW_PASSWORD=""
WECHAT_MINI_REVIEW_CHALLENGE_ID="wmc_review_audit"
# Set to 1 only during WeChat review; keep 0 in production.
WECHAT_MINI_REVIEW_MODE="0"

# Cloudflare Turnstile (https://dash.cloudflare.com/)
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# 定时任务鉴权：/api/cron/* 调用时须带 header "x-cron-secret: <值>"。
# 生产必须配置；未配置时仅放行本机回环地址（127.0.0.1/::1/localhost），空来源 IP 一律拒绝。
# crontab 示例：*/5 * * * * curl -fsS -H "x-cron-secret: <CRON_SECRET>" http://localhost:3000/api/cron/auto-close
CRON_SECRET=""

# Google reCAPTCHA v2 (optional backup)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Admin emails (comma-separated, lowercase)
# These users get role='admin' on signup
ADMIN_EMAILS=

# Public site URL (used for OG meta tags, sitemap)
NEXT_PUBLIC_SITE_URL=

# IndexNow key for Bing URL submission. Public by design; served at /indexnow-key.txt
# Generate with: openssl rand -hex 16
INDEXNOW_KEY=""

# Baidu Search Resource Platform active URL push (http://data.zz.baidu.com/urls)
# site must match the property verified in Baidu webmaster tools
BAIDU_PUSH_SITE=
BAIDU_PUSH_TOKEN=""

# Alipay computer website payment. Keep the private key in the deployment secret store only.
ALIPAY_APP_ID=""
ALIPAY_APP_PRIVATE_PKCS1_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_SELLER_ID=""
ALIPAY_GATEWAY=
# Configure this URL as the HTTP application gateway in Alipay Open Platform:
# https://libereal.cn/api/payments/alipay/message-gateway

# Cloud Mail Webmail (separate Workers app — staff login for support/sales/legal mailboxes)
NEXT_PUBLIC_CLOUD_MAIL_URL=

# System email (libereal main site transactional mail — Resend on verified main domain)
# Production on ECS: set EMAIL_PROVIDER=resend and the same RESEND_API_KEY as Cloud Mail admin.
# Original maillab/cloud-mail has no /api/external/send; do not use EMAIL_PROVIDER=http for Cloud Mail.
EMAIL_PROVIDER="console"
EMAIL_FROM=
# Leave empty until support@ mailbox exists in Cloud Mail (see docs/mail-system.md).
# EMAIL_REPLY_TO="support@libereal.cn"

# Resend HTTP provider (EMAIL_PROVIDER=resend) — verify libereal.cn in Resend dashboard first
RESEND_API_KEY=""

# Aliyun SMS (手机号验证码)
# 短信模板变量必须包含 ${code}
ALIYUN_SMS_ACCESS_KEY_ID=""
ALIYUN_SMS_ACCESS_KEY_SECRET=""
ALIYUN_SMS_SIGN_NAME=""
# Optional fallback template if scene-specific template codes are not set.
ALIYUN_SMS_TEMPLATE_CODE=""
ALIYUN_SMS_TEMPLATE_CODE_REGISTER=
ALIYUN_SMS_TEMPLATE_CODE_PHONE_CHANGE=
ALIYUN_SMS_TEMPLATE_CODE_RESET_PASSWORD=
# Optional: security actions fall back to RESET_PASSWORD when omitted.
ALIYUN_SMS_TEMPLATE_CODE_SECURITY=""
ALIYUN_SMS_REGION_ID="cn-hangzhou"
# Optional: separate secret for hashing local SMS verification codes.
SMS_CODE_SECRET=""

# Generic email HTTP provider (EMAIL_PROVIDER=http), for DirectMail gateways or internal relays
EMAIL_HTTP_ENDPOINT=""
EMAIL_HTTP_BEARER_TOKEN=""

# Reserved placeholders for future SMTP/DirectMail implementations; do not commit real secrets.
ALIYUN_DIRECTMAIL_ACCOUNT=""
ALIYUN_DIRECTMAIL_ACCESS_KEY_ID=""
ALIYUN_DIRECTMAIL_ACCESS_KEY_SECRET=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# Chatway widget
NEXT_PUBLIC_CHATWAY_WIDGET_ID=
# Optional Redis REST store for verification codes, rate limits, short caches, and task locks.
REDIS_REST_URL=""
REDIS_REST_TOKEN=""

# Enable only after the rule migration has been applied and every active campaign has SKU bindings.
PROMOTION_FOUNDATION_ENABLED="false"
